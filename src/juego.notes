C 0xceec Y se apunta que hay desplazamiento

L 0xCEF1 monitor_prefijo_ed  Busca en las dos tablas de las instrucciones ED
C 0xcef1 El byte de despues del prefijo
C 0xcef3 Primera tabla, con mascara
C 0xcef9 Segunda tabla, exacta
C 0xceff Y si no esta en ninguna, desconocida

L 0xCF02 monitor_busca_exacto  Recorre la tabla de tres en tres buscando el opcode
C 0xcf02 La entrada
C 0xcf03 0xFF termina la tabla
C 0xcf06 Contra el opcode
C 0xcf0b Tres bytes por entrada

L 0xCF10 monitor_busca_con_mascara  Aplica la mascara y compara con el valor
C 0xcf10 La mascara
C 0xcf12 El cero termina la tabla
C 0xcf13 Se aplica
C 0xcf17 Y se compara

L 0xCF75 monitor_signo_del_desplazamiento  Elige el '+' o el '-' del (IX+d)
C 0xcf75 El desplazamiento
C 0xcf76 Positivo: signo '+'
C 0xcf79 Negativo: se cambia de signo
C 0xcf7c Y el '-'

L 0xDC19 monta_la_pantalla_final  Rellena a mano un guion de doce bytes en 0xE002 y lo ejecuta
C 0xdc19 CLRSPR: borra todos los sprites
C 0xdc1c Vector de sonido
C 0xdc1f El area de trabajo
C 0xdc2a Un NOP en medio del relleno
C 0xdc30 El guion, en la RAM alta
C 0xdc50 Y se interpreta
C 0xdc53 El interprete de guiones
C 0xdc56 Numero de sprite
C 0xdc6a Dos sprites mas, con sus dos planos
C 0xdc7b El sprite del jugador
C 0xdc86 Y su posicion
C 0xdc8f Vector de sonido

L 0xDD59 sale_si_esta_congelado  Con 0x9C8F puesto, se vuelve sin hacer nada
C 0xdd5a La bandera que congela el juego
C 0xdd5e A cero: se sigue
C 0xdd60 Puesta: se vuelve

L 0xDDF0 monta_al_que_baja  Copia doce bytes de ficha y sortea donde aparece
C 0xddf0 La posicion
C 0xddf3 El area de trabajo de 0xF430
C 0xddf6 Doce bytes
C 0xddfe El primer campo
C 0xde00 Si ya esta en marcha, nada
C 0xde03 Estado 1
C 0xde09 El dado
C 0xde0c Ocho de base
C 0xde14 El dibujo
C 0xde1e Vector de sonido
C 0xde21 La fila de partida
C 0xde27 Otro dado
C 0xde2c Tres NOP: aqui habia una comprobacion
C 0xde2f El registro de refresco, de dado
C 0xde31 De 0 a 28
C 0xde39 Vector de sonido

L 0xDEA3 borra_las_cuatro  Borra las cuatro casillas de la posicion de 0xF433
C 0xdea3 La posicion
C 0xdea6 0x1F: hasta la fila de abajo
C 0xdea9 La primera
C 0xdead La de al lado
C 0xdeb1 Y las dos de abajo

L 0xDF62 sale_si_esta_congelado_2  El gemelo de 0xDD59, que ademas devuelve 0x8064
C 0xdf62 La bandera que congela el juego
C 0xdf66 El tampon que se devuelve
C 0xdf69 A cero: se devuelve normal
C 0xdf6a Puesta: se sale por dos niveles

L 0xDF8F prueba_las_cuatro  Mira las cuatro casillas del bloque de dos por dos
C 0xdf8f La primera
C 0xdf93 La de al lado
C 0xdf96 La fila de abajo
C 0xdf99 Y devuelve el area de trabajo

